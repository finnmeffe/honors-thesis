pacman::p_load(ggplot2, dplyr, tidyverse, data.table, lubridate, ggpubr, skimr, scales, plotly, tidycensus, readxl, httr, jsonlite, glue, sf, mapview, tigris, crsuggest, lwgeom, spatstat, patchwork)
# functions
unzip_shape <- function(file_url, sf_name) {
url <- glue(file_url)
tmp <- tempfile(fileext = ".zip")
download.file(url, tmp, mode = "wb")
st_read(paste0("/vsizip/", tmp)) %>%
st_transform("EPSG:4326")
}
# cross-walk data to connect county and cbsa
xwalk.cbsa_county <- read_csv("https://data.nber.org/cbsa-csa-fips-county-crosswalk/2023/cbsa2fipsxw_2023.csv") %>%
mutate(
fullfips = paste0(fipsstatecode,fipscountycode),
cbsacode = as.character(cbsacode)
) %>%
select(cbsacode,cbsatitle,fipsstatecode,fipscountycode,fullfips)
# get county shapefiles (not included in tiger place shapefiles)
sf.counties <- counties(
state = NULL,
cb = TRUE,
) %>%
left_join(xwalk.cbsa_county, by = join_by(GEOID == fullfips))
# plot to ensure data loaded correctly
ggplot(sf.counties %>%
filter(!STATEFP %in% c("02","15")) %>%
filter(as.numeric(STATEFP) < 57)
, aes(fill = cbsacode)) +
geom_sf() +
theme(legend.position = "none")
# initialize with CBSA code
needed_cbsacode = "42660"
needed_fips <- xwalk.cbsa_county %>%
filter(grepl(needed_cbsacode,cbsacode)) %>%
distinct(fullfips) %>%
pull(fullfips)
sf.places <-
st_intersection(
places(state = c(substr(needed_fips, start = 1, stop = 2) %>%
unique()),
cb = FALSE),
sf.counties %>%
filter(GEOID %in% c(needed_fips)) %>%
select()
) %>%
filter(LSAD %in% c("25","43")) # %>%
# erase_water(area_threshold = 0.9) this is optional, only really need for the boundaries
needed_crs <- suggest_crs(sf.places) %>%
filter(crs_units == "m") %>%
pull(crs_code) %>%
first()
# occasionally, places will be duplicated, so need to filter out duplicates
sf.places <- st_transform(sf.places, as.numeric(needed_crs)) %>%
group_by(GEOID) %>%
summarise(across(-geometry, first),
geometry = st_union(geometry), .groups = "drop")
# check sf with plot
ggplot(sf.places) +
geom_sf()
# now calculate a spatial index
sf.place_buffer <- st_minimum_bounding_circle(sf.places) %>%
select(GEOID) %>%
erase_water(area_threshold = 0.9) %>%
mutate(buffer_area = as.numeric(st_area(geometry))) %>%
st_drop_geometry()
sf.place_buffer_rect <- st_minimum_rotated_rectangle(sf.places) %>%
select(GEOID) %>%
erase_water(area_threshold = 0.9) %>%
mutate(rect_buffer_area = as.numeric(st_area(geometry))) %>%
st_drop_geometry()
sf.places <- inner_join(
sf.places, sf.place_buffer, by = join_by(GEOID == GEOID)
)
sf.places <- inner_join(
sf.places, sf.place_buffer_rect, by = join_by(GEOID == GEOID)
)
sf.places <- sf.places %>%
mutate(re_area = as.numeric(st_area(geometry)),
diff_circ = re_area/buffer_area,
diff_rect = re_area/rect_buffer_area) %>%
filter(re_area > 1000) %>% # this filters out extremely small areas (happens if clip performs weirdly)
arrange(-diff_rect)
# visualize some of this data
p1 = ggplot() +
geom_histogram(data = sf.places %>%
st_drop_geometry(),
aes(x = diff_circ),
bins = 20)
p2 = ggplot() +
geom_histogram(data = sf.places %>%
st_drop_geometry(),
aes(x = diff_rect),
bins = 20)
p1 + p2
p3 = ggplot() +
geom_sf(data = sf.places, aes(fill = diff_rect))
p4 = ggplot() +
geom_sf(data = sf.places, aes(fill = diff_circ))
p3 + p4
sf.places <- sf.places %>%
mutate(pct_area = re_area/sum(re_area))
index_circ <- sum(sf.places$diff_circ * sf.places$pct_area)
index_rect <- sum(sf.places$diff_rect * sf.places$pct_area)
