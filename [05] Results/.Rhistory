format_naics <- function(codes) {
a <- as.character(codes)
b <- ifelse(
nchar(a) <= 2,
str_pad(a, width = 6, side = "right", pad = "-"),
str_pad(a, width = 6, side = "right", pad = "/")
)
b
return(b)
}
format_naics(71)
zbp %>%
mutate(sector = "tech" if naics %in% format_naics(71))
?ifelse
zbp %>%
mutate(sector = case_when(
naics %in% format_naics(71) ~ "creative",
naics %in% format_naics(5112,5182,5417,5415) ~ "tech"
))
